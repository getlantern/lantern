#!/bin/sh
set -e

case "$1" in
configure)
	if ! getent group lantern >/dev/null 2>&1; then
		groupadd --system lantern >/dev/null 2>&1 || true
	fi
	if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ] && id "$SUDO_USER" >/dev/null 2>&1; then
		usermod -a -G lantern "$SUDO_USER" >/dev/null 2>&1 || true
	fi
	if command -v systemctl >/dev/null 2>&1; then
		systemctl daemon-reload >/dev/null 2>&1 || true
		systemctl enable --now lanternd.service >/dev/null 2>&1 || true
	fi
	;;
esac

exit 0
