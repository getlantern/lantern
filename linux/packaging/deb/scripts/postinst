#!/bin/sh
set -e

warn() {
	echo "lantern postinst: $*" >&2
}

case "$1" in
configure)
	LOG_LEVEL="$(cat /usr/lib/lantern/lanternd-log-level 2>/dev/null || printf '%s' trace)"
	if ! /usr/lib/lantern/lanternd install --log-level="$LOG_LEVEL"; then
		warn "failed to install lanternd service"
		exit 1
	fi
	;;
esac

exit 0
