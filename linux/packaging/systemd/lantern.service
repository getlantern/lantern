[Unit]
Description=Lantern VPN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/lantern/lanternd --data-path=/var/lib/lantern --log-path=/var/log/lantern --log-level=info
UMask=007

Restart=on-failure
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

DeviceAllow=/dev/net/tun rw
PrivateDevices=false

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

RuntimeDirectory=lantern
RuntimeDirectoryMode=0750
StateDirectory=lantern
CacheDirectory=lantern
LogsDirectory=lantern

LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
