<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home-screen banner (320x180dp): launch-screen logo over the wordmark,
     which Play's TV review requires on the banner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <!-- Sized explicitly: splash_logo is 250dp and would otherwise stretch the banner. -->
    <item
        android:width="104dp"
        android:height="104dp"
        android:top="16dp"
        android:gravity="center_horizontal|top"
        android:drawable="@drawable/splash_logo" />
    <item
        android:width="150dp"
        android:height="28dp"
        android:bottom="26dp"
        android:gravity="center_horizontal|bottom"
        android:drawable="@drawable/lantern_wordmark" />
</layer-list>
