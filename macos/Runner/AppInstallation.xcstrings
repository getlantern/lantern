    "Use Finder to move the app into Applications, then open it from there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Finder to move the app into Applications, then open it from there."
          }
        }
      }
    },
    "{appName} needs to run from /Applications to set up its VPN. It will copy itself there and reopen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{appName} needs to run from /Applications to set up its VPN. It will copy itself there and reopen."
          }
        }
      }
    },
    "{appName} needs to run from /Applications to set up its VPN. Quit the app, then drag it from its download location into Applications in Finder and open it from there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{appName} needs to run from /Applications to set up its VPN. Quit the app, then drag it from its download location into Applications in Finder and open it from there."
          }
        }
      }
    },
    "{error}\n\nQuit {appName}, then use Finder to move it to /Applications and open it there. You may need an administrator's permission.": {
